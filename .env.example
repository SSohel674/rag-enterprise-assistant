# Choose one provider: ollama (free, local) | openai | anthropic
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2

# Ollama (default): install from https://ollama.com then run: ollama pull llama3.2
OLLAMA_URL=http://localhost:11434

# OpenAI-compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=

# RAG tuning
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
MIN_RELEVANCE=0.25
GROUNDEDNESS_THRESHOLD=0.45
